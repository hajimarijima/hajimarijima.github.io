"b88fde425a":{"diary":[{"day":0,"date":"2026-11-26","text":"今日から村に住むことになった。よろしく。木のつるはしを持ってきた。まだ町は始まっていない。始まる日まで、島を見て回る。"},{"day":1,"date":"2026-11-27","text":"拠点が池のそばに決まった。テントを池のそばへ移した。夜中の0時から2時まで、もう少し働いた。夜のほうが元気が出る。夜中の2時、テントがいっぱいだったので、たき火のそばで横になって眠った。10時、岩を探して南の山まで歩いた。11時から、岩を何回もたたいて、かけらを掘り出した。丸石10。15時、遠くから村まで歩いて帰った。16時ごろ、村のまわりをぶらぶら歩いた。夕方は広場の冬祭りに行った。「はじまりの住人」のバッジをもらった。"}],"locks":[{"type":"level","at":3,"label":"Lv3 で解放","short":"Lv3"},{"type":"days","at":7,"label":"在籍 7 日で解放","short":"7日"},{"type":"days","at":14,"label":"在籍 14 日で解放","short":"14日"},{"type":"level","at":6,"label":"Lv6 で解放","short":"Lv6"},{"type":"days","at":30,"label":"在籍 30 日で解放","short":"30日"},{"type":"days","at":60,"label":"在籍 60 日で解放","short":"60日"},{"type":"level","at":10,"label":"Lv10 で解放","short":"Lv10"},{"type":"days","at":100,"label":"在籍 100 日で解放","short":"100日"},{"type":"level","at":15,"label":"Lv15 で解放","short":"Lv15"},{"type":"level","at":20,"label":"Lv20 で解放","short":"Lv20"},{"type":"level","at":25,"label":"Lv25 で解放","short":"Lv25"},{"type":"level","at":30,"label":"Lv30 で解放","short":"Lv30"},{"type":"level","at":35,"label":"Lv35 で解放","short":"Lv35"},{"type":"level","at":40,"label":"Lv40 で解放","short":"Lv40"},{"type":"level","at":45,"label":"Lv45 で解放","short":"Lv45"},{"type":"level","at":50,"label":"Lv50 で解放","short":"Lv50"},{"type":"level","at":55,"label":"Lv55 で解放","short":"Lv55"},{"type":"level","at":60,"label":"Lv60 で解放","short":"Lv60"},{"type":"level","at":65,"label":"Lv65 で解放","short":"Lv65"},{"type":"level","at":70,"label":"Lv70 で解放","short":"Lv70"},{"type":"level","at":75,"label":"Lv75 で解放","short":"Lv75"},{"type":"level","at":80,"label":"Lv80 で解放","short":"Lv80"},{"type":"level","at":85,"label":"Lv85 で解放","short":"Lv85"},{"type":"level","at":90,"label":"Lv90 で解放","short":"Lv90"}]}
